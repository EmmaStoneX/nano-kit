# Cloudflare Pages 配置
# 复制此文件为 wrangler.toml 并填入你的配置

name = "nano-banana-pro"
compatibility_date = "2024-01-01"

# Pages 项目配置
pages_build_output_dir = "dist"

# R2 存储桶绑定（需要先在 CF Dashboard 创建 R2 bucket）
[[r2_buckets]]
binding = "IMAGES_BUCKET"
bucket_name = "your-bucket-name"

# KV 命名空间绑定（需要先在 CF Dashboard 创建 KV namespace）
[[kv_namespaces]]
binding = "PROMPTS_KV"
id = "your-kv-namespace-id"

# 环境变量（部署时在 CF Dashboard 中设置，或使用 .env 文件）
# [vars]
# VITE_DEFAULT_API_TYPE = "openai"
# VITE_DEFAULT_API_HOST = "https://your-proxy.example.com"
# VITE_DEFAULT_API_KEY = "sk-your-api-key"
# VITE_DEFAULT_IMAGE_MODEL = "gpt-image-1"
# VITE_DEFAULT_PROVIDER_NAME = "默认渠道"
